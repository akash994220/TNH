rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Truefitt & Hill Staff Tools collection (state documents: task-manager, serial-queue, station-checklist, etc.)
    match /th-staff-tools/{docId} {
      allow read, write: if true;
    }

    // Shift Handover Notes collection
    match /th-staff-tools-notes/{noteId} {
      allow read, write: if true;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
